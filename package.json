{
  "name": "rentdock-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "check": "node scripts/check-source.mjs",
    "test": "node --test",
    "db:check": "node scripts/check-database.mjs",
    "db:verify": "node scripts/check-database.mjs --write",
    "phase:verify": "node scripts/verify-foundation.mjs",
    "auth:verify": "node scripts/verify-authentication.mjs",
    "stripe:setup": "node scripts/setup-stripe-sandbox.mjs",
    "stripe:check": "node scripts/check-stripe.mjs",
    "stripe:verify": "node scripts/check-stripe.mjs",
    "catalog:seed": "node scripts/seed-catalog.mjs",
    "catalog:verify": "node scripts/verify-catalog.mjs",
    "owner:verify": "node scripts/verify-owner.mjs",
    "images:check": "node scripts/check-images.mjs",
    "booking:verify": "node scripts/verify-bookings.mjs",
    "stripe:rental-check": "node scripts/check-rental-stripe.mjs",
    "stripe:listen": "node scripts/listen-stripe.mjs",
    "booking:demo": "node scripts/seed-booking-demo.mjs",
    "booking:report": "node scripts/report-booking-payment.mjs",
    "admin:setup": "node scripts/setup-admin.mjs",
    "admin:verify": "node scripts/verify-administration.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.27",
    "better-auth": "1.7.27",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "jose": "6.2.18",
    "mongodb": "7.9.1",
    "stripe": "23.2.0"
  }
}
