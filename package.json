{
  "name": "rentdock-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "check": "node scripts/check-source.mjs",
    "test": "node --test",
    "db:check": "node scripts/check-database.mjs",
    "db:verify": "node scripts/check-database.mjs --write",
    "phase:verify": "node scripts/verify-foundation.mjs",
    "stripe:setup": "node scripts/setup-stripe-sandbox.mjs",
    "stripe:check": "node scripts/check-stripe.mjs",
    "stripe:verify": "node scripts/check-stripe.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "mongodb": "7.9.1"
  }
}
